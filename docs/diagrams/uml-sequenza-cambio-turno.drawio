<mxfile host="drawio">
  <diagram id="sequenza-cambio-turno" name="Sequenza cambio turno">
    <mxGraphModel dx="1000" dy="760" grid="1" gridSize="10" guides="1" page="1" pageWidth="1000" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Diagramma di sequenza UML — cambio turno a doppia conferma" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="620" height="30" as="geometry" />
        </mxCell>
        <mxCell id="L1" value="Infermiere&lt;br&gt;richiedente" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=36;size=40;fontSize=12;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="100" height="660" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="Infermiere&lt;br&gt;collega" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=36;size=40;fontSize=12;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="240" y="60" width="100" height="660" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="Caposala" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=36;size=40;fontSize=12;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="420" y="60" width="100" height="660" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="API FastAPI&lt;br&gt;/cambi-turno" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="70" width="140" height="650" as="geometry" />
        </mxCell>
        <mxCell id="L5" value="SQLite" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=50;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="70" width="120" height="650" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="1. POST /cambi-turno/ (assegnazione, collega)" style="html=1;endArrow=block;endFill=1;fontSize=10;align=left;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="110" y="160" as="sourcePoint" /><mxPoint x="690" y="160" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="n1" value="verifica reparto,&lt;br&gt;assegnazione attiva" style="text;html=1;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="700" y="166" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="INSERT stato = in_attesa_collega" style="html=1;endArrow=block;endFill=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="690" y="222" as="sourcePoint" /><mxPoint x="900" y="222" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m3" value="201 Created" style="html=1;endArrow=open;dashed=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="690" y="250" as="sourcePoint" /><mxPoint x="110" y="250" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m4" value="2. POST /{id}/risposta-collega (accetta | rifiuta)" style="html=1;endArrow=block;endFill=1;fontSize=10;align=left;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="290" y="290" as="sourcePoint" /><mxPoint x="690" y="290" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="n2" value="utente = collega?&lt;br&gt;stato = in_attesa_collega?" style="text;html=1;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="700" y="295" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="UPDATE in_attesa_caposala | rifiutata_collega" style="html=1;endArrow=block;endFill=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="690" y="345" as="sourcePoint" /><mxPoint x="900" y="345" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m6" value="200 OK (richiesta aggiornata)" style="html=1;endArrow=open;dashed=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="690" y="375" as="sourcePoint" /><mxPoint x="290" y="375" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="alt" value="alt [collega ha accettato]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=170;height=26;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="400" y="405" width="580" height="235" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="3. POST /{id}/risposta-caposala (approva | rifiuta)" style="html=1;endArrow=block;endFill=1;fontSize=10;align=left;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="470" y="460" as="sourcePoint" /><mxPoint x="690" y="460" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="n3" value="stesso reparto?&lt;br&gt;stato = in_attesa_caposala?&lt;br&gt;nessun doppio turno?&lt;br&gt;(stessa regola assegnazione manuale)" style="text;html=1;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="700" y="465" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="scambio assegnazioni + stato approvata&lt;br&gt;(oppure rifiutata_caposala)" style="html=1;endArrow=block;endFill=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="690" y="565" as="sourcePoint" /><mxPoint x="900" y="565" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m9" value="200 OK | 409 Conflict (doppio turno)" style="html=1;endArrow=open;dashed=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="690" y="610" as="sourcePoint" /><mxPoint x="470" y="610" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="n4" value="Ogni controllo fallito: 403 (ruolo/reparto) o 409 (stato non valido)." style="text;html=1;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="725" width="520" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
