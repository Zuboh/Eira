ENVIRONMENT=development
DATABASE_URL=sqlite:///./consegne_infermieristiche.db
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Il seed è ammesso solo in development/E2E; in production viene sempre ignorato.
SEED_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Usare un valore ridotto soltanto negli ambienti di test isolati.
BCRYPT_ROUNDS=12
